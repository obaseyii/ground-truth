# Copy to .env.local and fill in. Never commit .env.local or keypair files.
# Names match lib/env.ts. npm run check-env checks them without printing values.

# Required
SOLANA_RPC_URL=
ADMIN_KEY=
VISION_MODEL=
ANTHROPIC_API_KEY=

# Mock USDC mint address, printed by npm run mint
USDC_MINT=

# Treasury: a keypair file path locally, or the secret key JSON array on a host
TREASURY_KEYPAIR_PATH=
TREASURY_SECRET_KEY=

# Test agent keypair, used by local scripts only
AGENT_KEYPAIR_PATH=

# Optional
GT_DB_PATH=
USE_FIXTURES=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
